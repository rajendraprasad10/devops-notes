6. Log Multiple Runs

Useful for hyperparameter tuning.

for depth in [2, 5, 10]:

    with mlflow.start_run():

        model = RandomForestClassifier(
            n_estimators=100,
            max_depth=depth
        )

        model.fit(X_train, y_train)

        predictions = model.predict(X_test)

        accuracy = accuracy_score(
            y_test,
            predictions
        )

        mlflow.log_param(
            "max_depth",
            depth
        )

        mlflow.log_metric(
            "accuracy",
            accuracy
        )

        print(depth, accuracy)





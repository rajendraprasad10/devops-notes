   Pod1   Pod2   Pod3


 Service Example
Pod:
	apiVersion: v1
	kind: Pod
	metadata:
	  name: nginx-pod
	  labels:
	    app: web
	spec:
	  containers:
	  - name: nginx
	    image: nginx

Service:

	apiVersion: v1
	kind: Service
	metadata:
	  name: web-service
	spec:
	  selector:
	    app: web
	  ports:
	  - port: 80
	    targetPort: 80

by default it is going with the service ip 


Creating Your First Pod

apiVersion: v1
kind: Pod
metadata:
  name: nginx-pod
  labels:
    app: nginx
spec:
  containers:
  - name: nginx-container
    image: nginx:latest
    ports:
      - containerPort: 80

kubectl apply -f pod.yaml

kubectl get pods

kubectl describe pod nginx-pod


kubectl logs nginx-pod

